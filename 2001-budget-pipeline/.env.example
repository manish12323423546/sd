# 2001 Budget Pipeline Environment Configuration

# Gemini 2.5 Pro API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-2.5-pro
GEMINI_THINKING_ENABLED=true
GEMINI_MAX_RETRIES=3
GEMINI_TIMEOUT_SECONDS=300
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_TOKENS=8192

# Pipeline Configuration  
PIPELINE_MAX_CONCURRENT_MODELS=3
PIPELINE_RETRY_ATTEMPTS=2
PIPELINE_PROGRESS_UPDATE_INTERVAL=5
PIPELINE_ENABLE_CACHING=true
PIPELINE_CACHE_TTL=3600
PIPELINE_EXECUTION_TIMEOUT=1800

# Memory State Management
MEMORY_MAX_EXECUTIONS=100
MEMORY_CLEANUP_INTERVAL=3600
MEMORY_EXECUTION_TTL=86400

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
API_ENABLE_CORS=true
API_LOG_LEVEL=INFO