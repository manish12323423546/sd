# Copy to .env (git-ignored) and paste your free keys. Leave a line empty to run that part locally.
# Fish Audio (expressive voices + voice cloning): https://fish.audio/app/api-keys
FISH_API_KEY=
# Groq (fast, accurate speech-to-text): https://console.groq.com/keys
GROQ_API_KEY=
# Deepgram Nova-3 (speech-to-text, used first when set; free credit on sign-up): https://console.deepgram.com/signup
DEEPGRAM_API_KEY=
# Speech-to-text choice: auto (Deepgram → Groq → offline) | deepgram | groq | local
LCV_ASR=auto
