{"voices": [{"id": "bm_george", "name": "The Veteran", "desc": "Warm, measured British broadcaster"}, {"id": "am_adam", "name": "Hype Host", "desc": "Energetic American host"}, {"id": "af_bella", "name": "Spark", "desc": "Bright, quick, playful"}, {"id": "am_michael", "name": "Coach", "desc": "Steady, confident analyst"}], "lines": [{"id": "L000001", "t_start": 1.504, "t_end": 4.96, "play_at": 9.692, "delay": 4.73, "text": "Good evening and welcome to Riverside Park for this evening's match.", "speaker": "S1", "emotion": "neutral", "seg": {"bm_george": [0.0, 3.53], "am_adam": [0.0, 3.45], "af_bella": [0.0, 3.67], "am_michael": [0.0, 3.78]}, "seg_fish": {"bm_george": [0.0, 3.25], "am_adam": [0.0, 3.16], "af_bella": [0.0, 3.24], "am_michael": [0.0, 3.34]}, "play_at_fish": 7.794}, {"id": "L000002", "t_start": 5.6, "t_end": 9.088, "play_at": 13.445, "delay": 4.36, "text": "It's a lovely night for football and both sides need it once.", "speaker": "S2", "emotion": "neutral", "seg": {"bm_george": [3.78, 2.98], "am_adam": [3.7, 3.33], "af_bella": [3.92, 3.42], "am_michael": [4.03, 3.47]}, "seg_fish": {"bm_george": [3.5, 3.2], "am_adam": [3.41, 3.18], "af_bella": [3.49, 3.16], "am_michael": [3.59, 3.42]}, "play_at_fish": 11.278}, {"id": "L000003", "t_start": 9.824, "t_end": 13.312, "play_at": 17.643, "delay": 4.33, "text": "Riverside Rovers get us underway, playing from left to right.", "speaker": "S1", "emotion": "neutral", "seg": {"bm_george": [7.01, 3.23], "am_adam": [7.28, 3.59], "af_bella": [7.59, 3.68], "am_michael": [7.75, 3.61]}, "seg_fish": {"bm_george": [6.95, 3.33], "am_adam": [6.84, 3.48], "af_bella": [6.9, 3.48], "am_michael": [7.26, 3.54]}, "play_at_fish": 15.265}, {"id": "L000004", "t_start": 13.824, "t_end": 16.096, "play_at": 20.728, "delay": 3.98, "text": "Okafor finds Lindqvist on the halfway line.", "speaker": "S1", "emotion": "neutral", "seg": {"bm_george": [10.49, 2.58], "am_adam": [11.12, 2.55], "af_bella": [11.52, 2.57], "am_michael": [11.61, 2.62]}, "seg_fish": {"bm_george": [10.53, 2.69], "am_adam": [10.57, 2.53], "af_bella": [10.63, 2.5513], "am_michael": [11.05, 2.55]}, "play_at_fish": 18.895}, {"id": "L000005", "t_start": 16.864, "t_end": 21.472, "play_at": 27.136, "delay": 5.66, "text": "Lindqvist has been in fine form this season, always looking for the pass forward.", "speaker": "S2", "emotion": "neutral", "seg": {"bm_george": [13.32, 4.21], "am_adam": [13.92, 4.5], "af_bella": [14.34, 4.72], "am_michael": [14.48, 4.79]}, "seg_fish": {"bm_george": [13.47, 4.01], "am_adam": [13.35, 4.34], "af_bella": [13.4313, 4.33], "am_michael": [13.85, 4.316]}, "play_at_fish": 23.803}, {"id": "L000006", "t_start": 22.048, "t_end": 24.672, "play_at": 31.198, "delay": 4.38, "text": "Northgate United sit deep and wait for the press.", "speaker": "S1", "emotion": "neutral", "seg": {"bm_george": [17.78, 2.74], "am_adam": [18.67, 2.76], "af_bella": [19.31, 2.84], "am_michael": [19.52, 2.78]}, "seg_fish": {"bm_george": [17.73, 2.95], "am_adam": [17.94, 2.69], "af_bella": [18.0113, 2.69], "am_michael": [18.416, 2.86]}, "play_at_fish": 28.243}, {"id": "L000007", "t_start": 25.216, "t_end": 29.216, "play_at": 34.525, "delay": 5.31, "text": "Moreau steps in and wins it back cleanly. That's the kind of tackle the manager will love.", "speaker": "S1", "emotion": "excited", "seg": {"bm_george": [20.77, 4.52], "am_adam": [21.68, 4.59], "af_bella": [22.4, 4.85], "am_michael": [22.55, 4.78]}, "seg_fish": {"bm_george": [20.93, 4.8431], "am_adam": [20.88, 4.54], "af_bella": [20.9513, 4.53], "am_michael": [21.526, 4.8892]}, "play_at_fish": 31.538}, {"id": "L000008", "t_start": 30.048, "t_end": 32.448, "play_at": 38.681, "delay": 4.4, "text": "Tanaka down the right wing past one past two.", "speaker": "S1", "emotion": "neutral", "seg": {"bm_george": [25.54, 2.66], "am_adam": [26.52, 2.51], "af_bella": [27.5, 2.46], "am_michael": [27.58, 2.56]}, "seg_fish": {"bm_george": [26.0231, 2.64], "am_adam": [25.67, 2.73], "af_bella": [25.7313, 2.6], "am_michael": [26.6652, 2.75]}, "play_at_fish": 35.779}, {"id": "L000009", "t_start": 32.896, "t_end": 34.336, "play_at": 41.074, "delay": 3.77, "text": "He cuts it back for Delgado.", "speaker": "S1", "emotion": "excited", "seg": {"bm_george": [28.45, 1.56], "am_adam": [29.28, 1.54], "af_bella": [30.21, 1.51], "am_michael": [30.39, 1.55]}, "seg_fish": {"bm_george": [28.9131, 1.57], "am_adam": [28.65, 1.6], "af_bella": [28.5813, 1.49], "am_michael": [29.6652, 1.6321]}, "play_at_fish": 38.428}, {"id": "L000010", "t_start": 34.656, "t_end": 35.136, "play_at": 42.519, "delay": 4.08, "text": "Oh what a chance.", "speaker": "S1", "emotion": "peak", "seg": {"bm_george": [30.26, 0.93], "am_adam": [31.07, 0.92], "af_bella": [31.97, 0.8], "am_michael": [32.19, 0.88]}, "seg_fish": {"bm_george": [30.7331, 0.96], "am_adam": [30.5, 0.98], "af_bella": [30.3213, 0.99], "am_michael": [31.5473, 1.13]}, "play_at_fish": 39.996}, {"id": "L000011", "t_start": 35.136, "t_end": 35.552, "play_at": 43.408, "delay": 4.77, "text": "Dance.", "speaker": "S1", "emotion": "excited", "seg": {"bm_george": [31.44, 0.61], "am_adam": [32.24, 0.56], "af_bella": [33.02, 0.52], "am_michael": [33.32, 0.61]}, "seg_fish": {"bm_george": [31.9431, 0.5951], "am_adam": [31.73, 0.62], "af_bella": [31.5613, 0.69], "am_michael": [32.9273, 0.5942]}, "play_at_fish": 41.086}, {"id": "L000012", "t_start": 35.648, "t_end": 37.984, "play_at": 44.018, "delay": 4.87, "text": "He has to slow down, the goal is wide open.", "speaker": "S2", "emotion": "excited", "seg": {"bm_george": [32.3, 2.26], "am_adam": [33.05, 2.3], "af_bella": [33.79, 2.42], "am_michael": [34.18, 2.47]}, "seg_fish": {"bm_george": [32.7882, 2.3673], "am_adam": [32.6, 2.46], "af_bella": [32.5013, 2.54], "am_michael": [33.7715, 2.5145]}, "play_at_fish": 41.585}, {"id": "L000013", "t_start": 38.784, "t_end": 41.12, "play_at": 46.098, "delay": 3.78, "text": "A goal kick then, and a lid off for Riverside.", "speaker": "S1", "emotion": "neutral", "seg": {"b