2.98], "am_michael": [52.75, 3.04]}, "seg_fish": {"bm_george": [49.9671, 2.99], "am_adam": [49.91, 3.19], "af_bella": [49.8219, 2.94], "am_michael": [52.036, 3.15]}, "play_at_fish": 61.344}, {"id": "L000018", "t_start": 58.368, "t_end": 60.64, "play_at": 66.069, "delay": 3.98, "text": "20 minutes gone, and it is still 0-0.", "speaker": "S2", "emotion": "neutral", "seg": {"bm_george": [51.9, 2.69], "am_adam": [53.48, 2.59], "af_bella": [55.4, 2.67], "am_michael": [56.04, 2.62]}, "seg_fish": {"bm_george": [53.2071, 3.07], "am_adam": [53.35, 2.95], "af_bella": [53.0119, 2.66], "am_michael": [55.436, 2.97]}, "play_at_fish": 63.984}, {"id": "L000019", "t_start": 61.152, "t_end": 63.104, "play_at": 68.47, "delay": 3.83, "text": "Moreau into the middle, now Tanaka again.", "speaker": "S1", "emotion": "neutral", "seg": {"bm_george": [54.84, 2.38], "am_adam": [56.32, 2.19], "af_bella": [58.32, 2.3], "am_michael": [58.91, 2.43]}, "seg_fish": {"bm_george": [56.5271, 2.54], "am_adam": [56.55, 2.6], "af_bella": [55.9219, 2.44], "am_michael": [58.656, 2.61]}, "play_at_fish": 66.214}, {"id": "L000020", "t_start": 63.616, "t_end": 65.984, "play_at": 70.69, "delay": 3.78, "text": "Tanaka through on goal. He goes around the keeper.", "speaker": "S1", "emotion": "excited", "seg": {"bm_george": [57.47, 2.71], "am_adam": [58.76, 2.71], "af_bella": [60.87, 2.77], "am_michael": [61.59, 2.85]}, "seg_fish": {"bm_george": [59.3171, 2.5587], "am_adam": [59.4, 2.74], "af_bella": [58.6119, 2.68], "am_michael": [61.516, 2.78]}, "play_at_fish": 68.464}, {"id": "L000021", "t_start": 66.112, "t_end": 68.832, "play_at": 73.291, "delay": 3.52, "text": "Go, go. Tanaka scores for Northgate United.", "speaker": "S1", "emotion": "peak", "seg": {"bm_george": [60.43, 2.12], "am_adam": [61.72, 2.49], "af_bella": [63.89, 2.7], "am_michael": [64.69, 2.54]}, "seg_fish": {"bm_george": [62.1257, 2.99], "am_adam": [62.39, 2.88], "af_bella": [61.5419, 3.11], "am_michael": [64.546, 3.18]}, "play_at_fish": 71.024}, {"id": "L000022", "t_start": 69.76, "t_end": 69.888, "play_at": 75.343, "delay": 2.71, "text": "And the-", "speaker": "S1", "emotion": "peak", "seg": {"bm_george": [62.8, 0.59], "am_adam": [64.46, 0.6], "af_bella": [66.84, 0.49], "am_michael": [67.48, 0.6]}, "seg_fish": {"bm_george": [65.3658, 0.383], "am_adam": [65.52, 0.6238], "af_bella": [64.9019, 0.572], "am_michael": [67.976, 0.6157]}, "play_at_fish": 72.789}, {"id": "L000023", "t_start": 69.888, "t_end": 75.52, "play_at": 82.016, "delay": 6.5, "text": "Unbelievable. What a finish from Tanaka. Look at the pace, look at the car. You made that look so easy.", "speaker": "S2", "emotion": "excited", "seg": {"bm_george": [63.64, 5.17], "am_adam": [65.31, 5.94], "af_bella": [67.58, 6.18], "am_michael": [68.33, 6.06]}, "seg_fish": {"bm_george": [65.9988, 5.89], "am_adam": [66.3937, 5.84], "af_bella": [65.7239, 6.48], "am_michael": [68.8417, 5.63]}, "play_at_fish": 77.801}, {"id": "L000024", "t_start": 76.224, "t_end": 78.592, "play_at": 87.261, "delay": 3.95, "text": "So Northgate United lead by one goal to know.", "speaker": "S1", "emotion": "neutral", "seg": {"bm_george": [69.06, 2.7], "am_adam": [71.5, 2.64], "af_bella": [74.01, 2.53], "am_michael": [74.64, 2.69]}, "seg_fish": {"bm_george": [72.1388, 2.62], "am_adam": [72.4838, 2.73], "af_bella": [72.4539, 2.62], "am_michael": [74.7217, 2.8299]}, "play_at_fish": 84.404}, {"id": "L000025", "t_start": 79.264, "t_end": 82.784, "play_at": 89.689, "delay": 4.27, "text": "Riverside have to respond now, they can't let the aim drift.", "speaker": "S2", "emotion": "neutral", "seg": {"bm_george": [72.01, 3.2], "am_adam": [74.39, 3.24], "af_bella": [76.79, 3.32], "am_michael": [77.58, 3.44]}, "seg_fish": {"bm_george": [75.0088, 3.36], "am_adam": [75.4638, 3.45], "af_bella": [75.3239, 3.22], "am_michael": [77.8015, 3.54]}, "play_at_fish": 86.836}, {"id": "L000026", "t_start": 83.36, "t_end": 87.136, "play_at": 92.586, "delay": 4.24, "text": "Lindqvist tries to lift his team, pointing for everyone to push up.", "speaker": "S1", "emotion": "neutral", "seg": {"bm_george": [75.46, 3.61], "am_adam": [77.88, 3.8], "af_bella": [80.36, 3.93], "am_michael": [81.27, 3.97]}, "seg_fish": {"bm_george": [78.6188, 3.27], "am_adam": [79.1637, 3.59], "af_bella": [78.7939, 3.58], "am_michael": [81.5915, 3.7123]}, "play_at_fish": 89.876}, {"id": "L000027", "t_start": 87.584, "t_end": 91.2, "play_at": 95.982, "delay": 4.78, "text": "A free kick on the right side for Riverside. This is a good area for Brennan.", "speaker": "S1", "emotion": "neutral", "seg": {"bm_george": [79.32, 4.19], "am_adam": [81.93, 4.38], "af_bella": [84.54, 4.61], "am_michael": [85.49, 4.57]}, "seg_fish": {"bm_george": [82.1388, 4.01], "am_adam": [83.0037, 4.2], "af_bella": [82.6239, 3.95], "am_michael": [85.5538, 4.13]}, "play_at_fish": 93.102}, {"id": "L000028", "t_start": 91.776, "t_end": 94.688, "play_at": 99.952, "delay": 4.3, "text": "Brennan whips it in. Okafor rises in the far post.", "speaker": "S1", "emotion": "neutral", "seg": {"bm_george": [83.76, 3.0], "am_adam": [86.56, 3.15], "af_bella": [89.4, 3.09], "am_michael": [90.31, 3.29]}, "seg_fish": {"bm_george": [86.3988, 3.04], "am_adam": [87.4537, 3.25], "af_bella": [86.8239, 3.39], "am_michael": [89.9338, 3.31]}, "play_at_fish": 97.112}, {"id": "L000029", "t_start": 94.976, "t_end": 95.168, "play_at": 102.745, "delay": 3.67, "text": "Dave.", "speaker": "S1", "emotion": "excited", "seg": {"bm_george": [87.01, 0.57], "am_adam": [89.96, 0.55], "af_bella": [92.74, 0.49], "am_michael": [93.85, 0.57]}, "seg_fish": {"bm_george": [89.6888, 0.4644], "am_adam": [90.9537, 0.5015], "af_bella": [90.4639, 0.768], "am_michael": [93.4938, 0.5948]}, "play_at_fish": 99.828}, {"id": "L000030", "t_start": 95.168, "t_end": 96.768, "play_at": 103.321, "delay": 4.22, "text": "Save what is saved by the keeper.", "speaker": "S1", "emotion": "peak", "seg": {"bm_george": [87.83, 1.53], "am_adam": [90.76, 1.57], "af_bella": [93.48, 1.51], "am_michael": [94.67, 1.5]}, "seg_fish": {"bm_george": [90.4032, 1.64], "am_adam": [91.7053, 1.61], "af_bella": [91.4819, 1.61], "am_michael": [94.3386, 1.65]}, "play_at_fish": 100.375}, {"id": "L000031", "t_start": 97.664, "t_end": 99.04, "play_at": 104.731, "delay": 3.43, "text": "That was right on the top for me.", "speaker": "S2", "emotion": "excited", "seg": {"bm_george": [89.61, 1.52], "am_adam": [92.58, 1.45], "af_bella": [95.24, 1.39], "am_michael": [96.42, 1.46]}, "seg_fish": {"bm_george": [92.2932, 1.4977], "am_adam": [93.5653, 1.56], "af_bella": [93.3419, 1.51], "am_michael": [96.2386, 1.67]}, "play_at_fish": 101.625}, {"id": "L000032", "t_start": 99.2, "t_end": 100.736, "play_at": 106.093, "delay": 3.48, "text": "An incredible reaction stop.", "speaker": "S2", "emotion": "excited", "seg": {"bm_george": [91.38, 1.61], "am_adam": [94.28, 1.59], "af_bella": [96.88, 1.47], "am_michael": [98.13, 1.56]}, "seg_fish": {"bm_george": [94.0409, 1.5063], "am_adam": [95.3752, 1.57], "af_bella": [95.1019, 1.6378], "am_michael": [98.1586, 1.7537]}, "play_at_fish": 102.974}, {"id": "L000033", "t_start": 101.568, "t_end": 104.448, "play_at": 108.262, "delay": 3.81, "text": "The corner comes to nothing and the game settles again.", "speaker": "S1", "emotion": "neutral", "seg": {"bm_george": [93.24, 2.89], "am_adam": [96.12, 3.05], "af_bella": [98.6, 3.01], "am_michael": [99.94, 3.11]}, "seg_fish": {"bm_george": [95.7971, 2.82], "am_adam": [97.1953, 2.77], "af_bella": [96.9898, 2.71], "am_michael": [100.1623, 2.84]}, "play_at_fish": 106.274}, {"id": "L000034", "t_start": 105.12, "t_end": 107.968, "play_at": 111.991, "delay": 4.02, "text": "Northgate look happened to slow it down until the breath.", "speaker": "S2", "emotion": "neutral", "seg": {"bm_george": [96.38, 2.79], "am_adam": [99.42, 2.67], "af_bella": [101.86, 2.79], "am_michael": [103.3, 2.83]}, "seg_fish": {"bm_george": [98.8671, 2.69], "am_adam": [100.2152, 2.74], "af_bella": [99.9497, 2.72], "am_michael": [103.2523, 2.95]